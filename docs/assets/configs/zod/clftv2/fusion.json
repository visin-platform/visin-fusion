{
  "extends": "clftv2",
  "Summary": "ZOD: clftv2 fusion, one epoch",
  "tags": [
    "zod",
    "clftv2",
    "fusion",
    "one-epoch"
  ],
  "CLI": {
    "mode": "fusion"
  },
  "Dataset": {
    "dataset_root": "$ZOD_DATA_DIR",
    "annotation_path": "annotation_fusion"
  },
  "Log": {
    "logdir": "logs/zod/clftv2/fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 1,
    "batch_size": 2,
    "seed": 0,
    "early_stop_patience": 1,
    "max_checkpoints": 1
  },
  "CLFTv2": {
    "warmup_epochs": 0,
    "pretrained": false
  }
}
