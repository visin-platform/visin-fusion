{
  "extends": "maskformer",
  "Summary": "ZOD: maskformer lidar, one epoch",
  "tags": [
    "zod",
    "maskformer",
    "lidar",
    "one-epoch"
  ],
  "CLI": {
    "mode": "lidar"
  },
  "Dataset": {
    "dataset_root": "$ZOD_DATA_DIR",
    "annotation_path": "annotation_lidar_only"
  },
  "Log": {
    "logdir": "logs/zod/maskformer/lidar"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 1,
    "batch_size": 2,
    "seed": 0,
    "early_stop_patience": 1,
    "max_checkpoints": 1
  },
  "MaskFormer": {
    "warmup_epochs": 0,
    "pretrained": false
  }
}
