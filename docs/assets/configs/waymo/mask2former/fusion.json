{
  "extends": "mask2former",
  "Summary": "WAYMO: mask2former fusion, one epoch",
  "tags": [
    "waymo",
    "mask2former",
    "fusion",
    "one-epoch"
  ],
  "CLI": {
    "mode": "fusion"
  },
  "Dataset": {
    "dataset_root": "$WAYMO_DATA_DIR",
    "annotation_path": "annotation"
  },
  "Log": {
    "logdir": "logs/waymo/mask2former/fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 1,
    "batch_size": 2,
    "seed": 0,
    "early_stop_patience": 1,
    "max_checkpoints": 1
  },
  "Mask2Former": {
    "warmup_epochs": 0,
    "pretrained": false
  }
}
