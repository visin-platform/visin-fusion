# Copy to your application .env or any external file and set VISIN_ENV_FILE to its path.
# Exported variables win over file values; never put credentials in the installed package.
# Without VISIN_TOKEN nothing is reported; every script still trains, tests and logs locally.

# Required to report: a pipeline key (the project's Settings -> Pipeline keys in Visin).
# The key decides which project runs go to. A legacy project token still works.
VISIN_TOKEN=

# Optional: the Visin API. Defaults to https://vision-api.visin.eu
# VISIN_URL=http://localhost:4010

# Optional: online (default), offline (keep reports on disk, send later with `visin sync`), or disabled
# VISIN_MODE=offline

# Optional: where offline reports are kept (default ~/.visin)
# VISIN_DIR=/scratch/visin

# Optional: set to false only for a deployment with a self-signed certificate
# VISIN_VERIFY_SSL=false
