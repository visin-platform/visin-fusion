# Your settings. `hpc.sh setup` writes this file for you; edit it any time. It holds secrets, so it is git-ignored.

# --- Visin -----------------------------------------------------------------------------------------
export VISIN_URL=
export VISIN_DATASET_URL=
export VISIN_TOKEN=                    # a pipeline key: the project's Settings -> Pipeline keys

# --- Hugging Face ----------------------------------------------------------------------------------
export HF_TOKEN=                       # a token with write access
HF_MODEL_REPO=                         # org/name; created private on the first upload

# --- What to run -----------------------------------------------------------------------------------
DATASET_ROOT_SPEC=visin:zod            # "visin:<name>", or "hf:org/name@<commit>" for a Hub dataset repo
SUITE_SLUG=zod-weather                 # the evaluation suite stage creates from the dataset's test splits
SUITE_VERSION=1

# --- Your cluster ----------------------------------------------------------------------------------
# Every SLURM_* setting that is empty is left out of the job, so the cluster's own default applies.
# `clusters/` has ready-made values for a few sites: copy the lines you need, or source one:
# source "$HPC_DIR/clusters/taltech.env"
WORK=$HOME/visin-work                  # must be visible from the login AND the compute nodes. Datasets are big:
                                       # use scratch or project storage, not a small home quota.
OFFLINE=1                              # 1 = compute nodes have no internet (the safe choice; `hpc.sh probe` tells you).
                                       # 0 = jobs report to Visin and upload to Hugging Face themselves.
SLURM_PARTITION=
SLURM_ACCOUNT=
SLURM_GRES=gpu:1                       # the GPU request, e.g. gpu:A100:1
SLURM_CONSTRAINT=
SLURM_CPUS=8
SLURM_MEM=32G
SLURM_TIME=2-00:00:00                  # time limit of the training job (days-hours:minutes:seconds)
SLURM_TEST_TIME=0-06:00:00             # time limit of the test + visualize + benchmark job
SLURM_MAIL_TYPE=                       # e.g. END,FAIL
SLURM_MAIL_USER=
SLURM_EXTRA=                           # anything else sbatch should get, e.g. "--qos=long --exclude=node07"

# --- Do not change ---------------------------------------------------------------------------------
export VISIN_DATA_DIR=$WORK/data
export VISIN_DIR=$WORK/spool           # reports that cannot be sent wait here, for `hpc.sh publish`
export HF_HOME=$WORK/hf
export TORCH_HOME=$WORK/torch
