# Example values for the TalTech HPC base cluster (A100 nodes). Use as a starting point: `source` this from env.sh
# and set your own account. Other sites need different names; ask your cluster's documentation or `sinfo`.
SLURM_PARTITION=gpu
SLURM_GRES=gpu:A100:1
SLURM_CONSTRAINT=A100-80
SLURM_CPUS=12
SLURM_MEM=32G
SLURM_TIME=5-0
SLURM_ACCOUNT=                         # your project allocation
