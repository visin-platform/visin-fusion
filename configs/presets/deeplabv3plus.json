{
  "description": "DeepLabV3+ (ResNet-101), late fusion of camera and LiDAR branches. Modes: rgb, lidar, fusion (default).",
  "CLI": {
    "backbone": "deeplabv3plus",
    "mode": "fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 200,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 200,
    "max_checkpoints": 2
  },
  "DeepLabV3Plus": {
    "backbone": "resnet101",
    "pretrained": true,
    "learning_rate": 8e-05,
    "warmup_epochs": 10,
    "lr_scheduler": {
      "type": "cosine",
      "eta_min": 1e-07
    },
    "fusion_strategy": "residual_average"
  },
  "Dataset": {
    "transforms": {
      "resize": 256,
      "random_rotate_range": 20,
      "p_flip": 0.5,
      "p_crop": 0.3,
      "p_rot": 0.4,
      "image_mean": [
        0.485,
        0.456,
        0.406
      ],
      "image_std": [
        0.229,
        0.224,
        0.225
      ]
    }
  }
}
