{
  "description": "CLFT: ViT camera + LiDAR fusion. Modes: rgb, lidar, cross_fusion (default).",
  "CLI": {
    "backbone": "clft",
    "mode": "cross_fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 300,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 200,
    "max_checkpoints": 2
  },
  "CLFT": {
    "emb_dim": 768,
    "hooks": [
      2,
      5,
      8,
      11
    ],
    "model_timm": "vit_base_patch16_384",
    "clft_lr": 8e-05,
    "warmup_epochs": 10,
    "patch_size": 16,
    "reassembles": [
      4,
      8,
      16,
      32
    ],
    "read": "projection",
    "resample_dim": 256,
    "type": "segmentation",
    "loss_depth": "ssi",
    "loss_segmentation": "ce",
    "lr_momentum": 0.99,
    "pretrained": true
  },
  "Dataset": {
    "transforms": {
      "resize": 384,
      "random_rotate_range": 20,
      "p_flip": 0.5,
      "p_crop": 0.3,
      "p_rot": 0.4,
      "image_mean": [
        0.485,
        0.456,
        0.406
      ],
      "image_std": [
        0.229,
        0.224,
        0.225
      ]
    }
  }
}
