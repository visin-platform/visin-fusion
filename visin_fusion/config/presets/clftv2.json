{
  "description": "CLFTv2: hierarchical Swin camera + LiDAR fusion. Modes: rgb, lidar, cross_fusion (default).",
  "CLI": {
    "backbone": "clftv2",
    "mode": "cross_fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 200,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 200,
    "max_checkpoints": 2
  },
  "CLFTv2": {
    "emb_dims": [
      96,
      192,
      384,
      768
    ],
    "hooks": [
      0,
      1,
      2,
      3
    ],
    "model_timm": "swinv2_tiny_window16_256",
    "fusion_strategy": "residual_average",
    "clft_lr": 8e-05,
    "warmup_epochs": 10,
    "patch_size": 4,
    "reassembles": [
      4,
      8,
      16,
      32
    ],
    "read": "ignore",
    "resample_dim": 256,
    "type": "segmentation",
    "pretrained": true
  },
  "Dataset": {
    "transforms": {
      "resize": 256,
      "random_rotate_range": 20,
      "p_flip": 0.5,
      "p_crop": 0.3,
      "p_rot": 0.4,
      "image_mean": [
        0.485,
        0.456,
        0.406
      ],
      "image_std": [
        0.229,
        0.224,
        0.225
      ]
    }
  }
}
