{
  "description": "MaskFormer with a Swin backbone, adapted to camera + LiDAR. Modes: rgb, lidar, cross_fusion (default).",
  "CLI": {
    "backbone": "maskformer",
    "mode": "cross_fusion"
  },
  "General": {
    "device": "cuda:0",
    "epochs": 100,
    "batch_size": 8,
    "seed": 0,
    "early_stop_patience": 200,
    "max_checkpoints": 2
  },
  "MaskFormer": {
    "model_timm": "swinv2_tiny_window16_256",
    "pixel_decoder_channels": 256,
    "transformer_d_model": 256,
    "num_queries": 100,
    "clft_lr": 8e-05,
    "warmup_epochs": 10,
    "lr_scheduler": "poly",
    "lr_poly_power": 0.9,
    "lr_step_milestones": [
      0.75,
      0.9
    ],
    "lr_step_gamma": 0.1,
    "pretrained": true,
    "eos_coef": 0.1
  },
  "Dataset": {
    "transforms": {
      "resize": 256,
      "random_rotate_range": 20,
      "p_flip": 0.5,
      "p_crop": 0.3,
      "p_rot": 0.4,
      "image_mean": [
        0.485,
        0.456,
        0.406
      ],
      "image_std": [
        0.229,
        0.224,
        0.225
      ]
    }
  }
}
